# Copy to .env locally. On Fly: fly secrets set KEY=value
# Never commit real secrets.

# ── Runtime ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
BASE_PATH=/
STATIC_DIR=/app/public
APP_VERSION=1.0.0
# Public HTTPS origin Exotel will call (no trailing slash). Required in production.
PUBLIC_BASE_URL=https://your-app.fly.dev
# Comma-separated CRM origins. Same-origin Docker/Fly can be left empty.
CORS_ORIGINS=

# ── Cost cap (₹2 / connected minute) ─────────────────────────────────────────
# strict = gpt-4o-mini only (required for the ₹2 cap)
# balanced = promote to gpt-4o on objections (will exceed ₹2)
# quality = gpt-4o always (do not use)
COST_MODE=strict
OPENAI_MODEL_MINI=gpt-4o-mini
OPENAI_MODEL_PREMIUM=gpt-4o
# Indicative telephony rates for the cost log — replace with YOUR Exotel rate card
COST_USD_INR=85
COST_EXOTEL_INBOUND_INR_PER_MIN=0.60
COST_EXOTEL_OUTBOUND_INR_PER_MIN=0.90
COST_ALERT_INR_PER_MIN=2

# ── Postgres (AWS RDS Mumbai — see docs/AWS_RDS.md) ──────────────────────────
DATABASE_URL=postgresql://sakshi:pass@shubham-motors-ai.XXXX.ap-south-1.rds.amazonaws.com:5432/sakshi?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────────
ADMIN_TOKEN=generate-a-long-random-string
# Optional: Exotel custom param must match or /call/stream is rejected
STREAM_SECRET=

# ── Voice ────────────────────────────────────────────────────────────────────
SARVAM_API_KEY=
# Keep v2 — v3 is ~2× TTS cost and blows the ₹2 budget
SARVAM_TTS_MODEL=bulbul:v2
OPENAI_API_KEY=
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2

# ── Exotel ───────────────────────────────────────────────────────────────────
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_VIRTUAL_NUMBER=
# Optional: comma-separated IPs allowed to hit /api/webhooks/*
EXOTEL_WEBHOOK_IPS=
SALES_TRANSFER_NUMBER=
# simultaneous (default): ring every active CRM sales contact; first to pick up wins
# round_robin: one salesperson per call, rotating
TRANSFER_STRATEGY=simultaneous

# ── WhatsApp (BotSpace) ──────────────────────────────────────────────────────
BOTSPACE_API_KEY=
BOTSPACE_PHONE_NUMBER_ID=

# ── Compliance ───────────────────────────────────────────────────────────────
RECORDING_NOTICE=1
# Set to 1 once legal signs off TRAI AI-disclosure greeting
AI_DISCLOSURE=0
